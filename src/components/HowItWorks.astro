---
import { howItWorksData } from '../data/howItWorks';
---

<section class="how-it-works-section section-light" id="como-funciona">
  <div class="container">
    <div class="section-header reveal-item">
      <span class="tech-badge tech-badge-light">{howItWorksData.badge}</span>
      <h2 class="section-title">{howItWorksData.title}</h2>
      <p class="section-subtitle">{howItWorksData.subtitle}</p>
    </div>

    <!-- Linha do Tempo de 4 Passos -->
    <div class="timeline-wrapper">
      <div class="timeline-line" aria-hidden="true"></div>

      <div class="steps-grid">
        {howItWorksData.steps.map((step) => (
          <div class="step-card card-light reveal-item">
            <div class="step-header">
              <span class="step-number">{step.stepNumber}</span>
              <span class="step-dot" aria-hidden="true"></span>
            </div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Prazos e Frase de Confiança -->
    <div class="reassurance-bar reveal-item">
      <span class="timeline-notice">{howItWorksData.timelineNotice}</span>
      <span class="divider-dot" aria-hidden="true">·</span>
      <span class="reassurance-phrase">{howItWorksData.reassurancePhrase}</span>
    </div>
  </div>
</section>

<style>
  .how-it-works-section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2rem;
    color: var(--text-on-light);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--muted-on-light);
  }

  /* Linha do Tempo */
  .timeline-wrapper {
    position: relative;
    margin-bottom: 3.5rem;
  }

  .timeline-line {
    display: none;
    position: absolute;
    top: 38px;
    left: 40px;
    right: 40px;
    height: 2px;
    background: linear-gradient(90deg, var(--mint-200), var(--mint-500), var(--mint-200));
    z-index: 0;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .step-card {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--mint-700);
    letter-spacing: -0.05em;
  }

  .step-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--mint-400);
    border: 3px solid var(--mint-100);
  }

  .step-title {
    font-size: 1.25rem;
    color: var(--text-on-light);
    line-height: 1.3;
  }

  .step-desc {
    font-size: 0.95rem;
    color: var(--muted-on-light);
    line-height: 1.6;
  }

  /* Barra de Reasseguração */
  .reassurance-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    background-color: var(--white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-pill);
    padding: 1rem 2rem;
    max-width: 650px;
    margin: 0 auto;
    box-shadow: var(--shadow-sm);
  }

  .timeline-notice {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mint-700);
    text-transform: uppercase;
  }

  .divider-dot {
    display: none;
    color: var(--mint-500);
    font-weight: 700;
  }

  .reassurance-phrase {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-on-light);
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .section-title {
      font-size: 2.5rem;
    }

    .reassurance-bar {
      flex-direction: row;
      gap: 1rem;
    }

    .divider-dot {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .timeline-line {
      display: block;
    }

    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
