---
import { comparisonData } from '../data/comparison';
---

<section class="comparison-section section-white" id="comparacao">
  <div class="container">
    <div class="section-header reveal-item">
      <span class="tech-badge tech-badge-light">{comparisonData.badge}</span>
      <h2 class="section-title">{comparisonData.title}</h2>
      <p class="section-subtitle">{comparisonData.subtitle}</p>
    </div>

    <!-- Tabela Comparativa Respeitosa -->
    <div class="table-wrapper reveal-item">
      <table class="comparison-table">
        <thead>
          <tr>
            <th scope="col" class="th-criterion">{comparisonData.aspectColumnHeader}</th>
            <th scope="col" class="th-solo">{comparisonData.soloColumnHeader}</th>
            <th scope="col" class="th-agency highlighted-header">{comparisonData.agencyColumnHeader}</th>
          </tr>
        </thead>
        <tbody>
          {comparisonData.rows.map((row) => (
            <tr>
              <th scope="row" class="td-criterion">
                <strong>{row.aspect}</strong>
              </th>
              <td class="td-solo">
                <span class="mobile-row-label">{comparisonData.soloColumnHeader}: </span>
                {row.solo}
              </td>
              <td class="td-agency highlighted-column">
                <span class="mobile-row-label">{comparisonData.agencyColumnHeader}: </span>
                <span class="agency-cell-content">
                  <svg class="agency-check" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="var(--mint-600)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="4 10 8 14 16 6"></polyline>
                  </svg>
                  <span>{row.withAgency}</span>
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2rem;
    color: var(--text-on-light);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--muted-on-light);
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    background-color: var(--white);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  th, td {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-light);
    vertical-align: top;
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: none;
  }

  thead th {
    font-family: var(--font-title);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-on-light);
    background-color: var(--surface-light);
    border-bottom: 2px solid var(--border-light);
  }

  .th-criterion {
    width: 25%;
  }

  .th-solo {
    width: 37.5%;
    color: var(--muted-on-light);
  }

  .th-agency {
    width: 37.5%;
  }

  .highlighted-header {
    background-color: var(--mint-100);
    color: var(--mint-900);
    border-bottom-color: var(--mint-300);
  }

  .td-criterion {
    font-family: var(--font-title);
    font-weight: 600;
    color: var(--text-on-light);
  }

  .td-solo {
    color: var(--muted-on-light);
    line-height: 1.55;
  }

  .highlighted-column {
    background-color: var(--mint-50);
    color: var(--text-on-light);
    font-weight: 500;
    line-height: 1.55;
  }

  .agency-cell-content {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .agency-check {
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .mobile-row-label {
    display: none;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .comparison-table thead {
      display: none;
    }

    .comparison-table, 
    .comparison-table tbody, 
    .comparison-table tr, 
    .comparison-table td,
    .comparison-table th {
      display: block;
      width: 100%;
    }

    .comparison-table tr {
      border-bottom: 2px solid var(--border-light);
      padding: 1rem;
    }

    .td-criterion {
      font-size: 1.15rem;
      color: var(--mint-900);
      padding: 0.5rem 0;
      border: none;
    }

    .td-solo {
      padding: 0.75rem 0;
      border: none;
    }

    .highlighted-column {
      padding: 0.75rem;
      border-radius: var(--radius-sm);
      margin-top: 0.5rem;
      border: none;
    }

    .mobile-row-label {
      display: inline;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      color: var(--mint-700);
      display: block;
      margin-bottom: 0.25rem;
    }
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 2.5rem;
    }
  }
</style>
