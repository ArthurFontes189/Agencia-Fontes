---
import { heroData } from '../data/hero';
import { whatsappLink } from '../data/site';

const primaryCtaHref = whatsappLink(heroData.primaryCtaMessage);
---

<section class="hero-section bg-tech-grid bg-radial-glow section-dark" id="hero">
  <div class="container hero-container">
    <!-- Conteúdo da Esquerda -->
    <div class="hero-content reveal-item">
      <!-- Selo de Status em Mono -->
      <div class="hero-badge-wrapper">
        <span class="tech-badge tech-badge-dark">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{heroData.badge}</span>
        </span>
      </div>

      <!-- Título Principal com Destaque -->
      <h1 class="hero-title">
        {heroData.titleBeforeHighlight}<span class="text-highlight">{heroData.titleHighlight}</span>{heroData.titleAfterHighlight}
      </h1>

      <!-- Subtítulo -->
      <p class="hero-subtitle">
        {heroData.subtitle}
      </p>

      <!-- Botões de Ação -->
      <div class="hero-actions">
        <a 
          href={primaryCtaHref} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary-dark"
        >
          <svg class="btn-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>{heroData.primaryCtaText}</span>
        </a>

        <a 
          href={heroData.secondaryCtaHref} 
          class="btn btn-secondary-dark"
        >
          <span>{heroData.secondaryCtaText}</span>
          <svg class="btn-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>

      <!-- Três Selos de Diferenciais -->
      <div class="hero-seals">
        {heroData.seals.map((seal) => (
          <div class="seal-item">
            <svg class="seal-icon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="var(--mint-300)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="4 10 8 14 16 6"></polyline>
            </svg>
            <span class="seal-text">{seal.text}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Composição Visual à Direita: Navegador + Smartphone Sobrepostos -->
    <div class="hero-visual reveal-item" aria-hidden="true">
      <div class="composition-wrapper">
        <!-- Janela de Navegador Desktop -->
        <div class="browser-window">
          <div class="browser-header">
            <div class="browser-dots">
              <span class="browser-dot"></span>
              <span class="browser-dot"></span>
              <span class="browser-dot"></span>
            </div>
            <div class="browser-url-bar">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>{heroData.mockup.browserBarTitle}</span>
            </div>
          </div>
          <div class="browser-body">
            <div class="mock-nav">
              <span class="mock-brand">{heroData.mockup.businessName}</span>
              <div class="mock-links">
                <span>{heroData.mockup.navItem1}</span>
                <span>{heroData.mockup.navItem2}</span>
              </div>
            </div>
            <div class="mock-hero-banner">
              <span class="mock-tagline">{heroData.mockup.businessTagline}</span>
              <div class="mock-h1">{heroData.mockup.heroHeadline}</div>
              <div class="mock-btn">{heroData.mockup.heroButton}</div>
            </div>
            <div class="mock-grid">
              <div class="mock-tile"></div>
              <div class="mock-tile"></div>
            </div>
          </div>
        </div>

        <!-- Smartphone Mobile Sobreposto -->
        <div class="smartphone-window">
          <div class="phone-speaker"></div>
          <div class="phone-screen">
            <div class="phone-bar">
              <span>{heroData.mockup.businessName}</span>
              <span class="phone-status-dot"></span>
            </div>
            <div class="phone-card">
              <span class="phone-badge">{heroData.mockup.phoneHeader}</span>
              <p class="phone-desc">{heroData.mockup.phoneStatus}</p>
              <div class="phone-cta">{heroData.mockup.phoneButton}</div>
            </div>
          </div>
        </div>

        <!-- Cartões Flutuantes com Rótulos Genéricos -->
        <div class="floating-cards-layer">
          {heroData.mockup.floatingCards.map((card, idx) => (
            <div class:list={['mock-float-card', `float-card-${idx + 1}`]}>
              <div class="float-icon-box">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--mint-300)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                  <path d="M2 17l10 5 10-5"></path>
                  <path d="M2 12l10 5 10-5"></path>
                </svg>
              </div>
              <div class="float-info">
                <strong class="float-title">{card.label}</strong>
                <span class="float-desc">{card.sublabel}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(72px + 3.5rem);
    padding-bottom: 4.5rem;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-badge-wrapper {
    display: flex;
  }

  .hero-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-on-dark);
  }

  .text-highlight {
    color: var(--mint-300);
    text-shadow: 0 0 20px rgba(126, 206, 202, 0.35);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--muted-on-dark);
    line-height: 1.6;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero-seals {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mint-alpha-10);
  }

  .seal-item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .seal-icon {
    flex-shrink: 0;
  }

  .seal-text {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-on-dark);
  }

  /* Composição Visual Mockup */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .composition-wrapper {
    position: relative;
    width: 100%;
    max-width: 520px;
    min-height: 380px;
  }

  /* Janela de Navegador */
  .browser-window {
    width: 90%;
    background-color: var(--ink-900);
    border: 1px solid var(--mint-alpha-25);
    border-radius: var(--radius-card);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .browser-header {
    background-color: var(--ink-800);
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--mint-alpha-15);
  }

  .browser-dots {
    display: flex;
    gap: 0.35rem;
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--mint-alpha-25);
  }

  .browser-url-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--ink-950);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-on-dark);
    flex-grow: 1;
    border: 1px solid var(--mint-alpha-10);
  }

  .browser-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mock-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--mint-alpha-06);
    padding-bottom: 0.5rem;
  }

  .mock-brand {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--mint-300);
  }

  .mock-links {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted-on-dark);
  }

  .mock-hero-banner {
    background: linear-gradient(135deg, var(--ink-800) 0%, var(--ink-900) 100%);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--mint-alpha-15);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mock-tagline {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--mint-400);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .mock-h1 {
    font-family: var(--font-title);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-on-dark);
  }

  .mock-btn {
    align-self: flex-start;
    background-color: var(--mint-600);
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .mock-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .mock-tile {
    height: 48px;
    background-color: var(--ink-800);
    border-radius: var(--radius-sm);
    border: 1px solid var(--mint-alpha-10);
  }

  /* Smartphone Mockup */
  .smartphone-window {
    position: absolute;
    bottom: -15px;
    right: 5px;
    width: 170px;
    background-color: var(--ink-950);
    border: 2px solid var(--mint-alpha-40);
    border-radius: 20px;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
    padding: 0.6rem 0.5rem;
    z-index: 2;
  }

  .phone-speaker {
    width: 35px;
    height: 3px;
    background-color: var(--ink-700);
    border-radius: 2px;
    margin: 0 auto 0.5rem;
  }

  .phone-screen {
    background-color: var(--ink-900);
    border-radius: 12px;
    padding: 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--mint-alpha-15);
  }

  .phone-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-on-dark);
  }

  .phone-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--mint-300);
  }

  .phone-card {
    background-color: var(--ink-800);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .phone-badge {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--mint-300);
    text-transform: uppercase;
  }

  .phone-desc {
    font-size: 0.6rem;
    color: var(--muted-on-dark);
    line-height: 1.3;
  }

  .phone-cta {
    background-color: var(--mint-300);
    color: var(--ink-950);
    font-size: 0.6rem;
    font-weight: 700;
    text-align: center;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  /* Cartões Flutuantes com Rótulos Genéricos */
  .floating-cards-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mock-float-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background-color: var(--ink-alpha-90);
    border: 1px solid var(--mint-alpha-25);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.85rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    z-index: 3;
  }

  .float-icon-box {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background-color: var(--ink-800);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .float-info {
    display: flex;
    flex-direction: column;
  }

  .float-title {
    font-size: 0.75rem;
    color: var(--text-on-dark);
    line-height: 1.2;
  }

  .float-desc {
    font-size: 0.65rem;
    color: var(--muted-on-dark);
  }

  .float-card-1 {
    top: 15px;
    right: -10px;
  }

  .float-card-2 {
    bottom: 50px;
    left: -15px;
  }

  .float-card-3 {
    top: 55%;
    left: -20px;
  }

  @media (min-width: 640px) {
    .hero-seals {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }

  @media (min-width: 992px) {
    .hero-section {
      padding-top: calc(72px + 5rem);
      padding-bottom: 6rem;
    }

    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }

    .hero-title {
      font-size: 3rem;
    }

    .composition-wrapper {
      max-width: 580px;
      min-height: 420px;
    }

    .smartphone-window {
      width: 190px;
      right: 15px;
      bottom: -20px;
    }
  }
</style>
