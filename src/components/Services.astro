---
import { servicesData } from '../data/services';
---

<section class="services-section section-white" id="servicos">
  <div class="container">
    <div class="section-header reveal-item">
      <span class="tech-badge tech-badge-light">{servicesData.badge}</span>
      <h2 class="section-title">{servicesData.title}</h2>
      <p class="section-subtitle">{servicesData.subtitle}</p>
    </div>

    <!-- Grade Assimétrica: 1º Card em Destaque Maior -->
    <div class="services-asymmetric-grid">
      {servicesData.services.map((service) => (
        <article class:list={['card-light service-card reveal-item', { 'featured-service-card': service.isFeatured }]}>
          <div class="service-card-top">
            <div class="service-icon-box">
              {service.iconName === 'browser' && (
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                  <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
              )}
              {service.iconName === 'map' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                  <line x1="8" y1="2" x2="8" y2="18"></line>
                  <line x1="16" y1="6" x2="16" y2="22"></line>
                </svg>
              )}
              {service.iconName === 'media' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              )}
              {service.iconName === 'ads' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                  <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
              )}
              {service.iconName === 'dashboard' && (
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
              )}
            </div>

            {service.tag && (
              <span class="service-tag">{service.tag}</span>
            )}
          </div>

          <div class="service-card-body">
            <h3 class="service-title">{service.title}</h3>
            <p class="service-phrase">{service.phrase}</p>
          </div>

          <div class="service-card-footer">
            <span class="target-label">{servicesData.targetAudienceLabel}</span>
            <p class="target-text">{service.targetAudience}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-top: 5rem;
    padding-bottom: 5.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2rem;
    color: var(--text-on-light);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--muted-on-light);
  }

  /* Grade Assimétrica */
  .services-asymmetric-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .service-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* Card em Destaque Maior (Site profissional) */
  .featured-service-card {
    background: linear-gradient(135deg, var(--white) 0%, var(--mint-50) 100%);
    border: 2px solid var(--mint-300);
    box-shadow: var(--shadow-md);
  }

  .service-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .service-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background-color: var(--mint-100);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .featured-service-card .service-icon-box {
    width: 60px;
    height: 60px;
    background-color: var(--mint-200);
  }

  .service-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mint-700);
    background-color: var(--mint-100);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--mint-200);
  }

  .service-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-title {
    font-size: 1.35rem;
    color: var(--text-on-light);
    line-height: 1.25;
  }

  .featured-service-card .service-title {
    font-size: 1.65rem;
    color: var(--mint-900);
  }

  .service-phrase {
    font-size: 1rem;
    color: var(--muted-on-light);
    line-height: 1.6;
  }

  .featured-service-card .service-phrase {
    font-size: 1.05rem;
  }

  .service-card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .target-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--mint-700);
  }

  .target-text {
    font-size: 0.9rem;
    color: var(--muted-on-light);
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .services-asymmetric-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .featured-service-card {
      grid-column: span 2;
    }

    .section-title {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services-asymmetric-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .featured-service-card {
      grid-column: span 2;
    }
  }
</style>
