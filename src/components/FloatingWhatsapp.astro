---
import { siteData, whatsappLink } from '../data/site';

const floatingHref = whatsappLink(siteData.floatingWhatsappMessage);
---

<aside class="floating-whatsapp-container" aria-label="Atendimento rápido pelo WhatsApp">
  <a 
    href={floatingHref} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="floating-whatsapp-btn"
    aria-label="Iniciar conversa no WhatsApp com a Agência Fontes"
  >
    <span class="pulsing-badge" aria-hidden="true"></span>
    <svg class="whatsapp-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <span class="floating-label">WhatsApp</span>
  </a>
</aside>

<style>
  .floating-whatsapp-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1.25rem;
    z-index: 999;
  }

  .floating-whatsapp-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--mint-300);
    color: var(--ink-950);
    padding: 0.75rem 1.15rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35), 0 0 15px rgba(126, 206, 202, 0.3);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    transition: transform var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
    min-height: 48px;
  }

  .floating-whatsapp-btn:hover {
    background-color: var(--mint-400);
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.45), 0 0 25px rgba(126, 206, 202, 0.5);
  }

  .whatsapp-icon {
    flex-shrink: 0;
  }

  .floating-label {
    display: none;
  }

  .pulsing-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    background-color: var(--mint-500);
    border: 2px solid var(--ink-950);
    border-radius: 50%;
    animation: pulse-ring 2s infinite ease-in-out;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(79, 186, 182, 0.7);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 6px rgba(79, 186, 182, 0);
    }
    100% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(79, 186, 182, 0);
    }
  }

  @media (min-width: 768px) {
    .floating-whatsapp-container {
      bottom: 2rem;
      right: 2rem;
    }

    .floating-label {
      display: inline-block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulsing-badge {
      animation: none;
    }
    .floating-whatsapp-btn {
      transition: none;
    }
  }
</style>
