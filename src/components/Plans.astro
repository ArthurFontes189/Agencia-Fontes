---
import { plansData } from '../data/plans';
import { whatsappLink } from '../data/site';

const helpWhatsappHref = whatsappLink(plansData.helpWhatsappMessage);
---

<section class="plans-section section-dark bg-tech-grid" id="planos">
  <div class="container">
    <div class="section-header reveal-item">
      <span class="tech-badge tech-badge-dark">{plansData.badge}</span>
      <h2 class="section-title">{plansData.title}</h2>
      <p class="section-subtitle">{plansData.subtitle}</p>
    </div>

    <!-- 3 Cards de Planos -->
    <div class="plans-grid">
      {plansData.plans.map((plan) => {
        const planCtaHref = whatsappLink(plan.whatsappMessage);
        return (
          <article class:list={['card-dark plan-card reveal-item', { 'popular-plan-card': plan.isPopular }]}>
            {plan.badge && (
              <div class="popular-badge-wrapper">
                <span class="tech-badge popular-badge">{plan.badge}</span>
              </div>
            )}

            <div class="plan-header">
              <h3 class="plan-name">{plan.name}</h3>
              <p class="plan-target">{plan.targetAudience}</p>
            </div>

            <div class="plan-pricing">
              <div class="price-row">
                <span class="price-label">{plansData.setupPriceLabel}</span>
                <span class="price-val setup-val">{plan.setupPrice}</span>
              </div>
              <div class="price-row monthly-row">
                <span class="price-label">{plansData.monthlyPriceLabel}</span>
                <span class="price-val monthly-val">{plan.monthlyPrice}</span>
              </div>
            </div>

            <ul class="plan-features-list">
              {plan.features.map((feature) => (
                <li class="plan-feature-item">
                  <svg class="check-icon" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="var(--mint-300)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="4 10 8 14 16 6"></polyline>
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <div class="plan-cta-wrapper">
              <a 
                href={planCtaHref} 
                target="_blank" 
                rel="noopener noreferrer" 
                class:list={['btn plan-cta-btn', plan.isPopular ? 'btn-primary-dark' : 'btn-secondary-dark']}
              >
                <span>{plan.ctaButtonText}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Módulos Adicionais em Lista Compacta -->
    <div class="additionals-wrapper card-dark reveal-item">
      <div class="additionals-header">
        <h3 class="additionals-title">{plansData.additionalsTitle}</h3>
        <span class="additionals-price-badge">{plansData.additionalsStartingPrice}</span>
      </div>

      <div class="additionals-grid">
        {plansData.additionals.map((add) => (
          <div class="additional-item">
            <span class="additional-bullet" aria-hidden="true">+</span>
            <div>
              <strong class="additional-name">{add.name}</strong>
              <p class="additional-desc">{add.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="additionals-help">
        <span class="help-question">{plansData.helpQuestion}</span>
        <a 
          href={helpWhatsappHref} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="help-link"
        >
          {plansData.helpCtaText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .plans-section {
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2.25rem;
    color: var(--text-on-dark);
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--muted-on-dark);
  }

  /* Grade de Planos */
  .plans-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .plan-card {
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    position: relative;
  }

  /* Card Popular (do meio) em Maior Destaque */
  .popular-plan-card {
    border: 2px solid var(--mint-300);
    box-shadow: var(--shadow-glow-mint);
    background: linear-gradient(180deg, var(--ink-800) 0%, var(--ink-900) 100%);
  }

  .popular-badge-wrapper {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
  }

  .popular-badge {
    background-color: var(--mint-300);
    color: var(--ink-950);
    border-color: var(--mint-300);
    box-shadow: 0 4px 12px rgba(126, 206, 202, 0.35);
  }

  .plan-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .plan-name {
    font-size: 1.75rem;
    color: var(--text-on-dark);
  }

  .plan-target {
    font-size: 0.95rem;
    color: var(--muted-on-dark);
    line-height: 1.5;
  }

  .plan-pricing {
    background-color: var(--ink-950);
    border: 1px solid var(--mint-alpha-15);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .price-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .price-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--muted-on-dark);
    letter-spacing: 0.05em;
  }

  .price-val {
    font-family: var(--font-title);
    font-weight: 700;
  }

  .setup-val {
    font-size: 1.15rem;
    color: var(--text-on-dark);
  }

  .monthly-row {
    padding-top: 0.65rem;
    border-top: 1px solid var(--mint-alpha-10);
  }

  .monthly-val {
    font-size: 1.4rem;
    color: var(--mint-300);
  }

  .plan-features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-grow: 1;
  }

  .plan-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: var(--text-on-dark);
    line-height: 1.45;
  }

  .check-icon {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .plan-cta-wrapper {
    padding-top: 0.5rem;
  }

  .plan-cta-btn {
    width: 100%;
    justify-content: center;
  }

  /* Bloco de Adicionais */
  .additionals-wrapper {
    margin-top: 4rem;
    padding: 2.25rem 2rem;
    border: 1px solid var(--mint-alpha-20);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .additionals-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .additionals-title {
    font-size: 1.4rem;
    color: var(--text-on-dark);
  }

  .additionals-price-badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--mint-300);
    background-color: var(--ink-800);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--mint-alpha-25);
  }

  .additionals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .additional-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .additional-bullet {
    color: var(--mint-300);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
  }

  .additional-name {
    display: block;
    font-size: 1rem;
    color: var(--text-on-dark);
    margin-bottom: 0.2rem;
  }

  .additional-desc {
    font-size: 0.85rem;
    color: var(--muted-on-dark);
    line-height: 1.4;
  }

  .additionals-help {
    padding-top: 1.5rem;
    border-top: 1px solid var(--mint-alpha-15);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-on-dark);
  }

  .help-link {
    color: var(--mint-300);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition-fast);
  }

  .help-link:hover {
    color: var(--mint-400);
  }

  @media (min-width: 768px) {
    .additionals-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .additionals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .plans-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .popular-plan-card {
      transform: scale(1.03);
      z-index: 2;
    }

    .popular-plan-card:hover {
      transform: scale(1.05) translateY(-4px);
    }

    .additionals-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .section-title {
      font-size: 2.75rem;
    }
  }
</style>
