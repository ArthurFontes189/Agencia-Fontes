---
import Logo from './Logo.astro';
import { siteData, whatsappLink } from '../data/site';

const headerWhatsappHref = whatsappLink("Olá! Vim pelo cabeçalho do site e gostaria de conversar.");
---

<header class="site-header" id="topo">
  <div class="container header-container">
    <Logo />

    <!-- Navegação Desktop -->
    <nav class="desktop-nav" aria-label="Navegação Principal">
      <ul class="nav-list">
        {siteData.navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Ação Direta Cabeçalho -->
    <div class="header-actions">
      <a 
        href={headerWhatsappHref} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-primary-dark header-cta"
      >
        <svg class="icon-whatsapp" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>{siteData.ctaButtonText}</span>
      </a>

      <!-- Botão Hambúrguer Mobile -->
      <button 
        type="button" 
        class="mobile-menu-btn" 
        id="mobileMenuBtn" 
        aria-label="Abrir menu de navegação" 
        aria-expanded="false" 
        aria-controls="mobileDrawer"
      >
        <span class="hamburger-box">
          <span class="hamburger-line line-1"></span>
          <span class="hamburger-line line-2"></span>
          <span class="hamburger-line line-3"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Drawer Mobile Acessível -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Navegação Mobile">
      <ul class="mobile-nav-list">
        {siteData.navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-footer">
        <a 
          href={headerWhatsappHref} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-primary-dark mobile-whatsapp-btn"
        >
          <svg class="icon-whatsapp" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          </svg>
          <span>{siteData.ctaButtonText}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobileMenuBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (!menuBtn || !mobileDrawer) return;
    menuBtn.setAttribute('aria-expanded', 'true');
    menuBtn.setAttribute('aria-label', 'Fechar menu de navegação');
    mobileDrawer.classList.add('is-open');
    mobileDrawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!menuBtn || !mobileDrawer) return;
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'Abrir menu de navegação');
    mobileDrawer.classList.remove('is-open');
    mobileDrawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  if (menuBtn && mobileDrawer) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Fechar ao pressionar a tecla Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        menuBtn.focus();
      }
    });

    // Fechar ao clicar em qualquer link interno
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: var(--ink-alpha-90);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--mint-alpha-10);
    transition: background-color var(--transition-normal);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Navegação Desktop */
  .desktop-nav {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted-on-dark);
    transition: color var(--transition-fast);
    padding: 0.5rem 0.25rem;
  }

  .nav-link:hover {
    color: var(--mint-300);
  }

  /* Ações e Botões */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-cta {
    display: none;
    font-size: 0.85rem;
    padding: 0.55rem 1.15rem;
    min-height: 42px;
  }

  .icon-whatsapp {
    flex-shrink: 0;
  }

  /* Botão Hambúrguer Mobile */
  .mobile-menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--mint-alpha-25);
    border-radius: var(--radius-sm);
    width: 44px;
    height: 44px;
    cursor: pointer;
    color: var(--text-on-dark);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-menu-btn:hover {
    background-color: var(--mint-alpha-10);
    border-color: var(--mint-300);
  }

  .hamburger-box {
    width: 20px;
    height: 14px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--mint-300);
    border-radius: 1px;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }

  /* Animação do botão quando aberto */
  .mobile-menu-btn[aria-expanded="true"] .line-1 {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-menu-btn[aria-expanded="true"] .line-2 {
    opacity: 0;
  }

  .mobile-menu-btn[aria-expanded="true"] .line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Drawer Mobile */
  .mobile-drawer {
    display: block;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ink-950);
    border-top: 1px solid var(--mint-alpha-15);
    padding: 2rem 1.5rem;
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform var(--transition-smooth), opacity var(--transition-smooth);
    overflow-y: auto;
  }

  .mobile-drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-nav-link {
    display: block;
    font-size: 1.25rem;
    font-family: var(--font-title);
    font-weight: 600;
    color: var(--text-on-dark);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--mint-alpha-06);
  }

  .mobile-nav-link:hover {
    color: var(--mint-300);
    padding-left: 0.5rem;
  }

  .mobile-drawer-footer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
  }

  .mobile-whatsapp-btn {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 992px) {
    .desktop-nav {
      display: block;
    }

    .header-cta {
      display: inline-flex;
    }

    .mobile-menu-btn {
      display: none;
    }

    .mobile-drawer {
      display: none;
    }
  }
</style>
