---
// <!-- TROCAR: revisar com profissional antes de publicar -->
import BaseLayout from '../layouts/BaseLayout.astro';
import { privacyData } from '../data/privacy';
import { siteData } from '../data/site';
---

<BaseLayout 
  title={`Política de Privacidade | ${siteData.name}`} 
  description="Saiba como a Agência Fontes cuida dos seus dados de contato com total transparência, respeito e sem compartilhamento com terceiros."
  isPrivacyPage={true}
>
  <main class="privacy-main section-light">
    <div class="container privacy-container">
      <div class="privacy-header">
        <a href="/" class="back-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{privacyData.backToHomeText}</span>
        </a>

        <span class="tech-badge tech-badge-light">{privacyData.badge}</span>
        <h1 class="privacy-title">{privacyData.title}</h1>
        <p class="privacy-subtitle">{privacyData.subtitle}</p>
        <span class="privacy-updated">{privacyData.lastUpdated}</span>
      </div>

      <!-- Conteúdo da Política de Privacidade -->
      <article class="privacy-content-card card-light">
        {privacyData.sections.map((section) => (
          <section class="privacy-section-block">
            <h2 class="section-heading">{section.title}</h2>
            {section.paragraphs.map((p) => (
              <p class="section-paragraph">{p}</p>
            ))}
          </section>
        ))}

        <!-- Contato do Encarregado / Responsável -->
        <div class="privacy-contact-box">
          <h3 class="contact-box-title">{privacyData.contactHeading}</h3>
          <p class="contact-box-text">{privacyData.contactText}</p>
          <div class="contact-box-badge">
            {/* TROCAR: Preencher com o e-mail ou contato do responsável pela privacidade */}
            <strong>{privacyData.responsibleContact}</strong>
          </div>
        </div>
      </article>

      <div class="privacy-footer-action">
        <a href="/" class="btn btn-secondary-light">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>{privacyData.backToHomeText}</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .privacy-main {
    padding-top: calc(72px + 4rem);
    padding-bottom: 6rem;
    min-height: 80vh;
  }

  .privacy-container {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .privacy-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--mint-700);
    margin-bottom: 0.5rem;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--mint-900);
  }

  .privacy-title {
    font-size: 2.5rem;
    color: var(--text-on-light);
    line-height: 1.2;
  }

  .privacy-subtitle {
    font-size: 1.15rem;
    color: var(--muted-on-light);
  }

  .privacy-updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-on-light);
  }

  .privacy-content-card {
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .privacy-section-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-heading {
    font-size: 1.25rem;
    color: var(--text-on-light);
  }

  .section-paragraph {
    font-size: 1rem;
    color: var(--muted-on-light);
    line-height: 1.7;
  }

  .privacy-contact-box {
    margin-top: 1rem;
    background-color: var(--surface-light);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-box-title {
    font-size: 1.1rem;
    color: var(--text-on-light);
  }

  .contact-box-text {
    font-size: 0.95rem;
    color: var(--muted-on-light);
  }

  .contact-box-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--mint-700);
    background-color: var(--mint-100);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--mint-200);
  }

  .privacy-footer-action {
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .privacy-title {
      font-size: 3rem;
    }
  }
</style>
