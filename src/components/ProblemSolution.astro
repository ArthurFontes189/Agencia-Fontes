---
import { problemSolutionData } from '../data/problemSolution';
---

<section class="problem-solution-section section-light" id="problema-solucao">
  <div class="container">
    <div class="section-header reveal-item">
      <span class="tech-badge tech-badge-light">{problemSolutionData.badge}</span>
      <h2 class="section-title">{problemSolutionData.title}</h2>
      <p class="section-subtitle">{problemSolutionData.subtitle}</p>
    </div>

    <div class="cards-grid">
      {problemSolutionData.items.map((item) => (
        <div class="card-light card-item reveal-item">
          <div class="icon-container">
            {item.iconName === 'search' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            )}
            {item.iconName === 'instagram' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            )}
            {item.iconName === 'message' && (
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--mint-700)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            )}
          </div>
          
          <div class="card-text-block">
            <div class="pain-line">
              <span class="status-cross" aria-hidden="true">✕</span>
              <strong class="pain-text">{item.problem}</strong>
            </div>
            <div class="arrow-indicator" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--mint-600)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
            <div class="solution-line">
              <span class="status-check" aria-hidden="true">✓</span>
              <span class="solution-text">{item.solution}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .problem-solution-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2rem;
    color: var(--text-on-light);
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--muted-on-light);
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .card-item {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .icon-container {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--mint-100);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-text-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pain-line {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .status-cross {
    color: var(--mint-700);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .pain-text {
    font-size: 1rem;
    color: var(--text-on-light);
    line-height: 1.4;
  }

  .arrow-indicator {
    padding-left: 1.5rem;
  }

  .solution-line {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background-color: var(--mint-50);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--mint-500);
  }

  .status-check {
    color: var(--mint-600);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .solution-text {
    font-size: 0.95rem;
    color: var(--mint-900);
    font-weight: 600;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .section-title {
      font-size: 2.5rem;
    }
  }
</style>
