---
import Logo from './Logo.astro';
import { siteData } from '../data/site';
import { footerData } from '../data/footer';
---

<footer class="site-footer section-dark" id="rodape">
  <div class="container footer-container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <Logo />
        <p class="footer-summary">{footerData.summary}</p>
        <div class="footer-meta-badges">
          <span class="tech-badge tech-badge-dark">{footerData.locationNotice}</span>
          {/* TROCAR: Quando o CNPJ for emitido, será exibido automaticamente */}
          <span class="cnpj-text">{footerData.cnpjLabel} {siteData.cnpj}</span>
        </div>
      </div>

      <!-- Links Rápidos de Navegação -->
      <nav class="footer-nav-col" aria-label="Navegação do Rodapé">
        <h4 class="footer-heading">Navegação</h4>
        <ul class="footer-links-list">
          {siteData.navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Informações Legais e Contato -->
      <div class="footer-legal-col">
        <h4 class="footer-heading">Transparência</h4>
        <ul class="footer-links-list">
          <li>
            <a href={footerData.privacyHref} class="footer-link privacy-link">{footerData.privacyLabel}</a>
          </li>
          <li>
            <span class="footer-info-item">{siteData.email}</span>
          </li>
          <li>
            <span class="footer-info-item">{siteData.instagram}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Linha de Copyright -->
    <div class="footer-bottom">
      <p class="copyright-text">
        © {new Date().getFullYear()} {footerData.copyrightNotice}
      </p>
      <p class="built-with-text">
        {footerData.builtWithNotice}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--ink-950);
    border-top: 1px solid var(--mint-alpha-15);
    padding-top: 5rem;
    padding-bottom: 3.5rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 420px;
  }

  .footer-summary {
    font-size: 0.95rem;
    color: var(--muted-on-dark);
    line-height: 1.6;
  }

  .footer-meta-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .cnpj-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-on-dark);
  }

  .footer-heading {
    font-family: var(--font-title);
    font-size: 1rem;
    color: var(--text-on-dark);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: var(--muted-on-dark);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--mint-300);
  }

  .privacy-link {
    color: var(--mint-300);
    font-weight: 500;
  }

  .footer-info-item {
    font-size: 0.85rem;
    color: var(--muted-on-dark);
    word-break: break-all;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--mint-alpha-10);
    align-items: center;
    text-align: center;
  }

  .copyright-text, .built-with-text {
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
